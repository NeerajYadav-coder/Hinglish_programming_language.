{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hinglish",
  "scopeName": "source.hinglish",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings-triple" },
    { "include": "#strings-fstring" },
    { "include": "#strings-single" },
    { "include": "#decorators" },
    { "include": "#function-definitions" },
    { "include": "#class-definitions" },
    { "include": "#keywords-control" },
    { "include": "#keywords-async" },
    { "include": "#keywords-exceptions" },
    { "include": "#keywords-pattern-matching" },
    { "include": "#keywords-declarations" },
    { "include": "#keywords-imports" },
    { "include": "#keywords-scoping" },
    { "include": "#operators-logical" },
    { "include": "#constants-language" },
    { "include": "#special-variables" },
    { "include": "#builtin-functions" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.hinglish",
      "match": "#.*$"
    },
    "strings-triple": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.hinglish",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#escapes" }
          ]
        },
        {
          "name": "string.quoted.triple.single.hinglish",
          "begin": "'''",
          "end": "'''",
          "patterns": [
            { "include": "#escapes" }
          ]
        }
      ]
    },
    "strings-fstring": {
      "patterns": [
        {
          "name": "string.interpolated.fstring.double.hinglish",
          "begin": "\\b[fF]\"",
          "end": "\"",
          "patterns": [
            { "include": "#fstring-expression" },
            { "include": "#escapes" }
          ]
        },
        {
          "name": "string.interpolated.fstring.single.hinglish",
          "begin": "\\b[fF]'",
          "end": "'",
          "patterns": [
            { "include": "#fstring-expression" },
            { "include": "#escapes" }
          ]
        }
      ]
    },
    "fstring-expression": {
      "begin": "(?<!\\\\)\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.hinglish" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.hinglish" }
      },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "strings-single": {
      "patterns": [
        {
          "name": "string.quoted.double.hinglish",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#escapes" }
          ]
        },
        {
          "name": "string.quoted.single.hinglish",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#escapes" }
          ]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.hinglish",
      "match": "\\\\(?:[abfnrtv\\\\'\"]|[0-7]{1,3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.hinglish",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.octal.hinglish",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.binary.hinglish",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.complex.hinglish",
          "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?[jJ]\\b"
        },
        {
          "name": "constant.numeric.float.hinglish",
          "match": "\\b\\d+\\.\\d+(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.hinglish",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "decorators": {
      "name": "meta.decorator.hinglish",
      "match": "(@)\\s*([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
      "captures": {
        "1": { "name": "punctuation.definition.decorator.hinglish" },
        "2": { "name": "entity.name.function.decorator.hinglish" }
      }
    },
    "function-definitions": {
      "match": "\\b(kaam)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.function.hinglish" },
        "2": { "name": "entity.name.function.hinglish" }
      }
    },
    "class-definitions": {
      "match": "\\b(varg|shreni)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.class.hinglish" },
        "2": { "name": "entity.name.type.class.hinglish" }
      }
    },
    "keywords-control": {
      "name": "keyword.control.hinglish",
      "match": "\\b(agar|warna_agar|warna|jabtak|har|mein|andar|ruko|aage_bado|aage_badho|chhod_do|wapas|upaj|se_upaj)\\b"
    },
    "keywords-async": {
      "name": "keyword.control.flow.async.hinglish",
      "match": "\\b(asamanantar|intezaar)\\b"
    },
    "keywords-exceptions": {
      "name": "keyword.control.exception.hinglish",
      "match": "\\b(koshish|pakdo|sambhalo|antatah|aakhir_mein|uthav|fenko|daawa|dawa)\\b"
    },
    "keywords-pattern-matching": {
      "name": "keyword.control.match.hinglish",
      "match": "\\b(milao|milaao|sthiti|vichaar)\\b"
    },
    "keywords-declarations": {
      "name": "keyword.declaration.hinglish",
      "match": "\\b(kaam|varg|shreni|sookshm)\\b"
    },
    "keywords-imports": {
      "name": "keyword.control.import.hinglish",
      "match": "\\b(laao|se|jaise|roop_mein)\\b"
    },
    "keywords-scoping": {
      "name": "keyword.other.statement.hinglish",
      "match": "\\b(saath|lekar|sarvavyapi|asthanik|asthaniya|hatao|mitao)\\b"
    },
    "operators-logical": {
      "name": "keyword.operator.logical.hinglish",
      "match": "\\b(aur|ya|nahi|hai)\\b"
    },
    "constants-language": {
      "name": "constant.language.hinglish",
      "match": "\\b(sahi|galat|kuch_nahi|shunya)\\b"
    },
    "special-variables": {
      "patterns": [
        {
          "name": "variable.language.self.hinglish",
          "match": "\\b(khood|self)\\b"
        },
        {
          "name": "variable.language.wildcard.hinglish",
          "match": "\\b_\\b"
        }
      ]
    },
    "builtin-functions": {
      "name": "support.function.builtin.hinglish",
      "match": "\\b(dikhao|chapo|batao|pucho|lambai|prakar|kram|purnank|dashamlav|akshar|kul_jod|adhiktam|nyuntam|khol)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.walrus.hinglish",
          "match": ":="
        },
        {
          "name": "keyword.operator.type.annotation.hinglish",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.hinglish",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.augmented.hinglish",
          "match": "\\+=|-=|\\*=|/=|//=|%=|&=|\\|=|\\^=|<<=|>>=|\\*\\*="
        },
        {
          "name": "keyword.operator.assignment.hinglish",
          "match": "=(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.hinglish",
          "match": "\\*\\*|\\*|//|/|\\+|-|%|@"
        },
        {
          "name": "keyword.operator.bitwise.hinglish",
          "match": "<<|>>|&|\\||\\^|~"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.colon.hinglish",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.hinglish",
          "match": ","
        },
        {
          "name": "punctuation.separator.period.hinglish",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.semicolon.hinglish",
          "match": ";"
        },
        {
          "name": "punctuation.bracket.round.hinglish",
          "match": "[()]"
        },
        {
          "name": "punctuation.bracket.square.hinglish",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.curly.hinglish",
          "match": "[{}]"
        }
      ]
    }
  }
}

{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"\"\"", "close": "\"\"\"" },
    { "open": "'''", "close": "'''" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:agar|warna|warna_agar|jabtak|har|kaam|varg|shreni|koshish|pakdo|sambhalo|antatah|aakhir_mein|saath|lekar|asamanantar|milao|milaao|sthiti|vichaar)\\b.*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:warna|warna_agar|pakdo|sambhalo|antatah|aakhir_mein|sthiti|vichaar)\\b.*:\\s*(?:#.*)?$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}

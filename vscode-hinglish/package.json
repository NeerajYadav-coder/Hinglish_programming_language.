{
  "name": "hinglish",
  "displayName": "Hinglish Language Support",
  "description": "Visual Studio Code syntax highlighting and language support for the Hinglish programming language.",
  "version": "1.0.0",
  "publisher": "neerajyadav",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "hinglish",
    "python",
    "syntax",
    "language",
    "hindi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NeerajYadav-coder/Hinglish_programming_language."
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:hinglish"
  ],
  "contributes": {
    "languages": [
      {
        "id": "hinglish",
        "aliases": [
          "Hinglish",
          "hinglish"
        ],
        "extensions": [
          ".hin"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hinglish",
        "scopeName": "source.hinglish",
        "path": "./syntaxes/hinglish.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Hinglish Language Server",
      "properties": {
        "hinglish.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Hinglish Language Server for intelligent editing features (diagnostics, completion, hover, go-to-definition, symbols, rename)."
        },
        "hinglish.lsp.path": {
          "type": "string",
          "default": "hinglish-lsp",
          "description": "Path to hinglish-lsp executable, or command to start the language server."
        },
        "hinglish.lsp.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter path used as fallback to execute python -m hinglish.lsp."
        },
        "hinglish.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Hinglish language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  }
}

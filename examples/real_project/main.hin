# Main project entrypoint

se json laao dumps
se asyncio laao run jaise async_run
se config laao get_app_info
se models laao Product, OrderItem, Order
se services laao OrderService
se utils laao mudra_format, current_timestamp

dikhao(f"=== {get_app_info()} ===")
dikhao(f"Execution started at: {current_timestamp()}")

# 1. Setup sample catalog
laptop = Product("P-101", "Developer Laptop", 75000.0, sahi)
mouse = Product("P-102", "Wireless Mouse", 1500.0, sahi)
keyboard = Product("P-103", "Mechanical Keyboard", 4500.0, sahi)

dikhao(f"Catalog loaded: {laptop.description()}, {mouse.description()}, {keyboard.description()}")

# 2. Build orders
order1 = Order("ORD-001", "Aarav Sharma")
order1.add_item(OrderItem(laptop, 1))
order1.add_item(OrderItem(mouse, 2))

order2 = Order("ORD-002", "Priya Verma")
order2.add_item(OrderItem(keyboard, 1))

# 3. Process via OrderService
svc = OrderService()
svc.place_order(order1)
svc.place_order(order2)

dikhao(f"Order 1 total (with tax): {mudra_format(order1.total_amount)}")
dikhao(f"Order 2 total (with tax): {mudra_format(order2.total_amount)}")

# 4. Comprehension query
large_orders = svc.get_large_order_ids(5000.0)
dikhao(f"High value orders: {large_orders}")

# 5. Async processing
async_msg = async_run(svc.settle_order_async(order1))
dikhao(f"Async settlement: {async_msg}")

# 6. Pattern matching on order status
har ord mein svc.orders:
    milaao ord.status:
        vichaar "settled":
            dikhao(f"[STATUS] {ord.order_id} is fully verified and settled!")
        vichaar "placed":
            dikhao(f"[STATUS] {ord.order_id} is placed, awaiting settlement.")
        vichaar _:
            dikhao(f"[STATUS] {ord.order_id} has status: {ord.status}")

# 7. Safe exception handling test
koshish:
    invalid_product = Product("P-ERR", "Free Item", -100.0, galat)
pakdo ValueError jaise err:
    dikhao(f"[CAUGHT EXPECTED ERROR] Validation prevented invalid product: {err}")

dikhao("=== Hinglish Real Project Completed Successfully ===")
